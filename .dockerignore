.git
.github

# Terraform keeps provider binaries for the host platform under .terraform. They
# are gitignored, so CI never sees them, but a local build would copy a macOS
# provider binary into a Linux image: dead weight that also carries its own CVEs.
**/.terraform
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*

.env
.env.*
!.env.example

data/raw/uploaded_jobs.csv
data/processed/uploaded_processed_jobs.csv
deploy/security-reports

*.pyc
*.pyo
*.pyd
.DS_Store

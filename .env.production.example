# Copy to .env.production on the server and replace every placeholder value.

COMPOSE_PROJECT_NAME=joblens-prod
JOBLENS_IMAGE_TAG=latest

# Public domain handled by Caddy.
JOBLENS_DOMAIN=jobs.example.com
CADDY_ACME_EMAIL=admin@example.com

# PostgreSQL container credentials. The password appears twice and the two must
# match exactly; the secret audit fails the deploy if they drift. Use a
# hex or alphanumeric value so it needs no URL escaping inside DATABASE_URL.
POSTGRES_DB=joblens_ai
POSTGRES_USER=joblens
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://joblens:replace-with-a-long-random-password@db:5432/joblens_ai

# Public origins for the deployed site and API paths.
JOBLENS_CORS_ORIGINS=https://jobs.example.com
JOBLENS_API_ROOT_PATH=/api
JOBLENS_RATE_LIMIT_ENABLED=true
JOBLENS_ANALYZE_RATE_LIMIT=60
JOBLENS_RATE_LIMIT_WINDOW_SECONDS=60

# Where the Next.js server reaches FastAPI. This stays on the private Docker
# network; the browser never uses it, so it is not a public URL.
JOBLENS_API_URL=http://api:8000

# Optional skill extraction providers.
GROQ_API_KEY=
GROQ_API_KEY_NEXT=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_API_KEY_NEXT=

# Django operations portal.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=jobs.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.example.com
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_AGE=28800

# Worker counts for one small Linux server.
API_WORKERS=2
DJANGO_WORKERS=2

[Unit]
Description=Back up the JobLens PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=joblens
Group=joblens
WorkingDirectory=/srv/joblens-ai
Environment=DEPLOY_ENV_FILE=.env.production
Environment=COMPOSE_FILE=docker-compose.prod.yml
Environment=BACKUP_DIR=/srv/joblens-backups
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_RETENTION_COUNT=14
ExecStart=/srv/joblens-ai/deploy/scripts/backup_database.sh
